# ==============================================================================
# SISTEM TERINTEGRASI - VARIABEL LINGKUNGAN CONTOH (.env.example)
#
# PANDUAN PENGGUNAAN:
# 1. Salin file ini menjadi .env.local:
#    cp .env.example .env.local
# 2. Buat kunci acak kriptografis secara otomatis:
#    node scripts/generate-keys.mjs
# 3. JANGAN PERNAH menyimpan file .env atau .env.local ke dalam version control (git).
# ==============================================================================

# Mode Lingkungan ('development', 'production', 'test')
NODE_ENV=development

# Port Server Backend
PORT=4000

# Level Logging Pino ('debug', 'info', 'warn', 'error')
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL 17+)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_local_dev
POSTGRES_DB=sistem_db
# URL koneksi untuk API backend (menggunakan localhost pada laptop)
DATABASE_URL=postgresql://postgres:postgres_password_local_dev@127.0.0.1:5432/sistem_db

# ------------------------------------------------------------------------------
# CACHE & ANTRIAN (Redis 7+)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# PENYIMPANAN BERKAS OBJECT STORAGE (MinIO / S3)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret_dev
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret_dev
MINIO_BUCKET_NAME=sistem-terintegrasi-files

# ------------------------------------------------------------------------------
# PEMINDAI VIRUS (ClamAV)
# ------------------------------------------------------------------------------
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ------------------------------------------------------------------------------
# KEAMANAN KRIPTOGRAFI (WAJIB DIBUAT DENGAN scripts/generate-keys.mjs)
# JANGAN GUNAKAN NILAI DEFAULT INI DI LINGKUNGAN SELAIN DEV LOKAL
# ------------------------------------------------------------------------------
# Key Encryption Key (KEK) / App Secret: Minimal 32 karakter
APP_SECRET=generate_with_scripts_generate_keys_mjs_min_32_characters!

# Data Encryption Key (DEK) untuk AES-256-GCM kolom terenkripsi (*_enc) (hex 64 karakter)
DEK_ENCRYPTION_KEY=

# Blind Index Salt untuk HMAC-SHA256 pencarian (*_hash) (hex 64 karakter)
BLIND_INDEX_SALT=

# Rahasia Token JWT Sesi & Refresh Token
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ------------------------------------------------------------------------------
# REVERSE PROXY & HOST
# ------------------------------------------------------------------------------
CADDY_DOMAIN=localhost
NEXT_PUBLIC_API_URL=http://localhost/api

